# Copy to .env and fill in. .env is gitignored.

# Google Calendar OAuth (Desktop app client from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Which calendar to show. "primary" = the authorizing account's main calendar.
# For a specific calendar, use its ID (Google Calendar > settings > "Calendar ID").
GCAL_CALENDAR_ID=primary

# Shopify (read-only sales tile). Copy these from the agent's .env on the server.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Dashboard server
DASH_BIND=127.0.0.1
DASH_PORT=8002
